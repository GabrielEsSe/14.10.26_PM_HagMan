<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0C2EC"
    tools:context=".MainActivity">
    <TextView
        android:layout_marginTop="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:id="@+id/palabrita"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0C2EC"
        android:gravity="center"
        android:paddingTop="15dp">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gallows"
            android:layout_marginBottom="40dp"></ImageView>
        <ImageView
            android:id="@+id/cabeza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/head"
            android:paddingStart="108dp"
            android:paddingTop="23dp"
            android:visibility="invisible"></ImageView>
        <ImageView
            android:id="@+id/cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/body"
            android:paddingStart="120dp"
            android:paddingTop="53dp"
            android:visibility="invisible"></ImageView>
        <ImageView
            android:id="@+id/brazoIzquierdo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arm_left"
            android:paddingStart="100dp"
            android:paddingTop="60dp"
            android:visibility="invisible"></ImageView>
        <ImageView
            android:id="@+id/brazoDerecho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arm_right"
            android:paddingStart="120dp"
            android:paddingTop="60dp"
            android:visibility="invisible"></ImageView>
        <ImageView
            android:id="@+id/piernaIzquierda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/leg_left"
            android:paddingStart="101dp"
            android:paddingTop="90dp"
            android:visibility="invisible"></ImageView>
        <ImageView
            android:id="@+id/piernaDerecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/leg_right"
            android:paddingStart="121dp"
            android:paddingTop="90dp"
            android:visibility="invisible"></ImageView>
    </RelativeLayout>
    <TextView
        android:id="@+id/txtPalabraOculta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:background="@android:color/white"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center"/>

    <EditText
        android:id="@+id/inputLetra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="@android:color/black"
        android:maxLength="1" />

    <Button
        android:id="@+id/btnAdivinar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jugar" />

</LinearLayout>